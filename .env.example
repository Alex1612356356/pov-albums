# Copy this file to .env and replace both values before starting the app.
ADMIN_PASSWORD=replace-with-a-long-random-password
DATA_PATH=./data

# Optional. Set this to the URL guests should scan/open.
# Example for LAN-only use: http://192.168.1.20:3000
# Example behind HTTPS reverse proxy: https://albums.example.com
BASE_URL=
